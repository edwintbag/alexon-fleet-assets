# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key   # server only, never share

# Your deployed address (used in email links)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Daily email (optional until you set it up) — https://resend.com
RESEND_API_KEY=
EMAIL_FROM="Alexon Fleet <fleet@alexongroupltd.co.ke>"

# Protects the daily email job. Any long random string. Vercel sends it automatically.
CRON_SECRET=change-me-to-a-long-random-string
